{
  "name": "dsh-fix-attachments",
  "version": "0.1.0",
  "description": "修「附件对象被删 → 会话永远报 DeepSeek Messages transport failed」：DSH 插件（进程内自愈）+ 离线 CLI",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cli/repair": "./cli/src/repair.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-fix-attachments": "cli/bin/dsh-fix-attachments.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "cli/bin",
    "cli/src",
    "docs/upstream-issue.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "attachment",
    "image",
    "recovery",
    "rescue",
    "transport-failed",
    "zstd",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuzhunzhi/dsh-fix-attachments.git"
  },
  "bugs": {
    "url": "https://github.com/xuzhunzhi/dsh-fix-attachments/issues"
  },
  "homepage": "https://github.com/xuzhunzhi/dsh-fix-attachments#readme"
}
